<!--
  osgEarth spike map. Paths are resolved relative to this file, so the
  build copies it next to the exe; pass an explicit path on the command
  line to use the copy in the source tree instead.

  Fully offline by default: imagery is rendered on the fly from the
  OpenMapTiles vector MBTiles (Pakistan) that EarthView/Doctrine already use.
-->
<map name="EarthView osgEarth spike" version="3">

    <!-- Offline imagery: vector MBTiles rasterised per tile with a MapBox GL
         style. Path to the .mbtiles file is set in osm_style.json ("sources").
         Only fill/line layers are styled (no labels, so no glyph/sprite files).
         KNOWN ISSUE (osgEarth 3.8.1 from vcpkg, 2026-10-08): this layer renders
         nothing, not even a background-only style. Reading the same file through
         <OGRFeatures> + <FeatureImage> hangs while GDAL scans it. Until fixed, use
         the online XYZImage layer below or a raster MBTiles file. -->

    <MapBoxGLImage name="OSM vector (offline)">
        <url>osm_style.json</url>
    </MapBoxGLImage>

    <!-- Online raster alternative (same default as EarthView's TmsLoader).
         Respect the OSM tile usage policy.
    <XYZImage name="OpenStreetMap">
        <url>https://tile.openstreetmap.org/{z}/{x}/{y}.png</url>
        <profile>spherical-mercator</profile>
        <attribution>&#169;OpenStreetMap contributors</attribution>
    </XYZImage>
    -->

    <!-- Offline raster alternative: any raster (PNG/JPEG) MBTiles file.
    <MBTilesImage name="Local imagery">
        <filename>D:/Source/EarthView1/EarthView/Data/OSM/imagery.mbtiles</filename>
    </MBTilesImage>
    -->

    <!-- Coarse 90 m DEM (global fallback, listed first = lower priority). -->
    <GDALElevation name="DEM90">
        <url>D:/Source/EarthView1/EarthView/Data/DEM/DEM90TIF/N18.tif</url>
    </GDALElevation>

    <!-- SRTM 1-arc-second DTED2, 34 tiles N30-N34 / E066-E077, mosaicked by
         dted_1arc.vrt (relative paths to the .dt2 files next to it).
         For faster zoomed-out loading, build overviews once:
           gdaladdo -ro dted_1arc.vrt 2 4 8 16 32 64 -->
    <GDALElevation name="SRTM 1arc DTED2">
        <url>D:/Source/EarthView1/EarthView/Data/DEM/dted_1arc.vrt</url>
    </GDALElevation>

    <!-- Vector overlay straight from EarthView's shapefile, clamped to terrain. -->
    <FeatureModel name="Country borders">
        <OGRFeatures>
            <url>D:/Source/EarthView1/EarthView/Data/Borders/World_Countries_Generalized_Shapefile/World_Countries_Generalized.shp</url>
        </OGRFeatures>
        <styles>
            <style type="text/css">
                default {
                    stroke: #ffd24a;
                    stroke-width: 2px;
                    altitude-clamping: terrain-drape;
                    render-lighting: false;
                }
            </style>
        </styles>
    </FeatureModel>

</map>
