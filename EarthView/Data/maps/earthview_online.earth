<!--
  earthview3d map with ONLINE OpenStreetMap imagery (needs internet; respect the OSM tile usage policy).
  Otherwise identical to earthview.earth, which is the offline default.

  osgEarth resolves every path below relative to THIS file, so it lives inside the data
  tree: <DataRoot>/maps/earthview.earth, with <DataRoot> = EarthView/Data.
    ../imagery/world_base.tif   land/sea base for the whole globe (in git, 0.8 MB)
    ../imagery/base.tif         detailed base map for an AOI   } generated by
    ../imagery/hillshade.tif    shaded relief from DTED        } tools/offline_data/
    ../Cities/places_*.gpkg     place-name points              } build_offline_data.py
    ../DEM/dted_1arc.vrt        SRTM 1" DTED2 mosaic (git-ignored; copy the .dt2 tiles locally)
    ../Borders/...              country borders shapefile (in git)
  Missing local files only drop that layer; osgEarth logs a warning.
-->
<map name="EarthView" version="3">

    <!-- Imagery, bottom to top. world_base is always present (in git); base and hillshade
         appear once build_offline_data.py has been run. -->
    <GDALImage name="World base">
        <url>../imagery/world_base.tif</url>
    </GDALImage>

    <GDALImage name="Base map">
        <url>../imagery/base.tif</url>
    </GDALImage>

    <!-- Online imagery over the local base map (falls back to it when offline). -->
    <XYZImage name="OpenStreetMap">
        <url>https://tile.openstreetmap.org/{z}/{x}/{y}.png</url>
        <profile>spherical-mercator</profile>
        <attribution>&#169;OpenStreetMap contributors</attribution>
    </XYZImage>

    <!-- Shaded relief multiplies (modulates) the layers below it. -->
    <GDALImage name="Hillshade" blend="modulate" opacity="0.85">
        <url>../imagery/hillshade.tif</url>
    </GDALImage>

    <!-- SRTM 1-arc-second DTED2, 34 tiles N30-N34 / E066-E077, mosaicked by
         dted_1arc.vrt (relative paths to the .dt2 files next to it). Overviews for faster
         zoomed-out loading: build_offline_data.py dem-overviews (gdaladdo -ro).
         DTED heights are orthometric (EGM96 mean sea level). vdatum="egm96" makes osgEarth
         convert them to WGS-84 ellipsoid heights (HAE), the frame of every other position in
         the 3D view (D-021). Near Islamabad the geoid is ~47 m below the ellipsoid. -->
    <GDALElevation name="SRTM 1arc DTED2">
        <url>../DEM/dted_1arc.vrt</url>
        <vdatum>egm96</vdatum>
    </GDALElevation>

    <!-- Vector overlay straight from EarthView's shapefile, clamped to terrain. -->
    <FeatureModel name="Country borders">
        <OGRFeatures>
            <url>../Borders/World_Countries_Generalized_Shapefile/World_Countries_Generalized.shp</url>
        </OGRFeatures>
        <styles>
            <style type="text/css">
                default {
                    stroke: #ffd24a;
                    stroke-width: 2px;
                    altitude-clamping: terrain-drape;
                    render-lighting: false;
                }
            </style>
        </styles>
    </FeatureModel>

    <!-- Place names (from Data/Cities/*.ndjson via build_offline_data.py places). Paged in
         tiles so only labels near the camera are built; decluttered. -->
    <FeatureModel name="Places (cities, towns)">
        <OGRFeatures>
            <url>../Cities/places_major.gpkg</url>
        </OGRFeatures>
        <layout tile_size="100000" crop_features="true">
            <level max_range="400000"/>
        </layout>
        <styles>
            <style type="text/css">
                default {
                    text-content: [name];
                    text-size: 15;
                    text-fill: #ffffff;
                    text-halo: #303030;
                    text-declutter: true;
                    text-align: center_center;
                    altitude-clamping: terrain;
                }
            </style>
        </styles>
    </FeatureModel>

    <FeatureModel name="Places (villages, hamlets)">
        <OGRFeatures>
            <url>../Cities/places_minor.gpkg</url>
        </OGRFeatures>
        <layout tile_size="20000" crop_features="true">
            <level max_range="40000"/>
        </layout>
        <styles>
            <style type="text/css">
                default {
                    text-content: [name];
                    text-size: 12;
                    text-fill: #f0f0e0;
                    text-halo: #303030;
                    text-declutter: true;
                    text-align: center_center;
                    altitude-clamping: terrain;
                }
            </style>
        </styles>
    </FeatureModel>

    <!-- Lat/lon grid, off by default (GlobeView3D: key R / setLayerVisible("Graticule")). -->
    <GeodeticGraticule name="Graticule" visible="false">
        <!-- ascii, NOT utf8: osgEarth's LatLongFormatter emits the degree sign as the single
             Latin-1 byte 0xB0, which is not valid UTF-8. osgText's ASCII path maps that byte
             straight to U+00B0; its UTF-8 path treats 0xB0 as a lead byte and swallows the
             following digit with it. ascii is also osgText's default, so this line documents
             the trap rather than changing behaviour. The missing glyph itself was the font:
             configureRuntime() now re-reads osgEarth's default font once the OSG plugin folder
             is registered (D-025), so no font is pinned here. -->
        <grid_label_style>default { text-encoding: ascii; text-fill: #ffffff; text-declutter: false; }</grid_label_style>
        <edge_label_style>default { text-encoding: ascii; text-fill: #ffffff; text-declutter: false; }</edge_label_style>
    </GeodeticGraticule>

</map>
